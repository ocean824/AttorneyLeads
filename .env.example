# AttorneyLeads Environment Variables
# Copy this to .env and fill in your actual values (never commit .env to git)

# ============================================
# Core Database
# ============================================
DATABASE_URL=postgres://user:password@host:5432/dbname

# ============================================
# OpenAI via Replit AI Integrations
# ============================================
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# External Integrations (Optional)
# ============================================

# PhantomBuster - LinkedIn/Facebook prospect discovery
PHANTOMBUSTER_API_KEY=your-phantombuster-key
PHANTOM_AGENT_ID=your-phantom-agent-id

# Calendly - Meeting scheduling automation
CALENDLY_API_KEY=your-calendly-key
CALENDLY_USER_URI=your-calendly-user-uri

# Google Sheets - Data export/sync
GOOGLE_SHEETS_TOKEN=your-google-sheets-token

# ============================================
# Runtime Configuration
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# Session Management
# ============================================
SESSION_SECRET=your-session-secret-change-in-production
